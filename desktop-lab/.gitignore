# Node
node_modules/

# Staged web root (scripts/stage-frontend.mjs mirrors canary-local + the
# enclosure library here before every dev/build run — generated, never edited)
dist/

# Rust / Tauri build output
src-tauri/target/

# Sidecars — CI downloads these per-platform (binaries/espflash-<triple>);
# src-tauri/binaries/.gitignore says the same from inside the folder
src-tauri/binaries/espflash-*

# Tauri mobile scaffolding (generated on demand; this app ships desktop only)
src-tauri/gen/

# Tauri may emit a schema cache here
src-tauri/.tauri/
