{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SecuraCV Lab",
  "version": "0.1.1",
  "identifier": "com.securacv.lab",
  "build": {
    "beforeDevCommand": "node scripts/stage-frontend.mjs",
    "beforeBuildCommand": "node scripts/stage-frontend.mjs",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "SecuraCV Lab",
        "url": "canary-local/lab.html",
        "width": 1200,
        "height": 820,
        "minWidth": 880,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Utility",
    "shortDescription": "The local-first Canary workshop.",
    "longDescription": "Meet your Canary before you meet your Canary. The SecuraCV Lab runs the real firmware, live 3D device cards, and symptom-first fix-it flows entirely on your own machine. Local-first — nothing phones home.",
    "linux": {
      "deb": {
        "depends": ["libwebkit2gtk-4.1-0", "libgtk-3-0"]
      }
    },
    "macOS": {
      "minimumSystemVersion": "10.15",
      "dmg": {
        "background": "dmg/background.png",
        "windowSize": {
          "width": 660,
          "height": 480
        },
        "appPosition": {
          "x": 175,
          "y": 220
        },
        "applicationFolderPosition": {
          "x": 485,
          "y": 220
        }
      }
    }
  }
}
