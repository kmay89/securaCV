    {
     "title": "Start with the desk cradle",
     "readmeStep": null,
     "note": "Prints flat, no hardware: front lip and back rail form the bottom channel, the fin takes the 25-degree lean. Shown seated so the assembly axis reads true."
    },
    {
     "title": "The bezel frame",
     "readmeStep": null,
     "note": "Face shell with the 2.5 mm glass lip, USB-C slot in the bottom wall, chimney vents up top. Prints face-down — the A-surface is your build plate."
    },
    {
     "title": "Drop the panel in face-first",
     "readmeStep": null,
     "note": "Glass lands against the bezel lip; the rear stack faces you. Waveshare publishes no full mechanical drawing — MEASURE your panel; the render is a stand-in built to the BOM’s nominals."
    },
    {
     "title": "Close the vented back",
     "readmeStep": null,
     "note": "Carries two keyholes and the 75 mm horizontal M4 pair (a true VESA-75 square can’t fit this panel height)."
    },
    {
     "title": "Drive the four M2s — snug, diagonal",
     "readmeStep": null,
     "note": "Last and outermost: from the back, through the counterbores, into the corner lobes outside the panel cavity. Diagonal order, then a final quarter-turn."
    }
