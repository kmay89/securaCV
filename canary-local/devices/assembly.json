    {
     "title": "Start with the stand",
     "readmeStep": null,
     "note": "The 25-degree cradle prints upright, no supports. The whole build is shown seated in it so the assembly axis reads true — on the bench you assemble the puck flat on the desk, then rest it here."
    },
    {
     "title": "Rest the drum in the cradle",
     "readmeStep": null,
     "note": "The drum is the back shell — every part nests into its bore. Its blind keyholes wall-mount the puck without the stand."
    },
    {
     "title": "Lay in the optional battery",
     "readmeStep": null,
     "note": "A protected 302030 cell drops between the fence rails on the drum floor, lead to the display’s JST 1.25. VERIFY polarity against the board — vendor pigtails vary."
    },
    {
     "title": "Seat the XIAO, then the display stack",
     "readmeStep": null,
     "note": "The XIAO clicks into the Round Display’s back socket (zero wiring), and the whole stack slides into the drum, USB aligned to the wall slot."
    },
    {
     "title": "Cap it with the bezel",
     "readmeStep": null,
     "note": "The bezel’s seat receives the display disc; the aperture lands on the display’s own bezel ring. Face chamfer out."
    },
    {
     "title": "Drive the two M2s — snug, not cranked",
     "readmeStep": null,
     "note": "Last and outermost, like every proper fastener: through the bezel counterbores into the drum posts. Max ~0.3 N·m into printed posts."
    }
   ]
