   "steps": [
    {
     "title": "Start with the stand",
     "readmeStep": 0,
     "note": "The cradle prints upright, no supports: a full-depth divot bored normal to the 25° reclined face, thumb scallops to lift the puck out, and a chin slot that passes the USB-C cable into the open channel under the base."
    },
    {
     "title": "Rest the drum in the cradle",
     "readmeStep": 1,
     "note": "The drum sinks 11 mm into the divot — it cannot rock or roll, and its USB slot lands in the chin channel. The blind keyhole in its back wall-mounts the puck without the stand."
    },
    {
     "title": "Pin the XIAO into the display's back socket",
     "readmeStep": 2,
     "note": "The XIAO rides the Round Display's own two 7-pin headers — component side away from the display, USB-C at the disc edge. Zero wiring; the display's charger, RTC and SD come along for free."
    },
    {
     "title": "Lower the stack into the bore",
     "readmeStep": 3,
     "note": "The Ø43.0 disc slides down the Ø44.4 bore (measured from the vendor CAD — the disc is 43 mm, not the marketing 39), USB-C aligned to the side slot. The trim ring stops 0.4 mm below the rim."
    },
    {
     "title": "Snap the bezel home",
     "readmeStep": 4,
     "note": "The bezel's skirt drops into the bore over the disc edge and its four nubs click into the wall slots — no fasteners. The aperture shows the full glass and lands on the display's own trim ring."
    }
   ]
  },
