# Rust build output
src-tauri/target/
src-tauri/gen/
hub-core/target/
# hub-core has no dependencies, so its lockfile is trivial and regenerates
# deterministically in CI — like src-tauri, we don't track it.
hub-core/Cargo.lock

# Node
node_modules/

# Sidecars — CI downloads these per-platform (binaries/espflash-<triple>)
src-tauri/binaries/espflash-*

# Generated icon set — CI runs `tauri icon` from icons/source.png.
# The source PNG and its generator ARE tracked; the derived files are not.
src-tauri/icons/*.png
src-tauri/icons/*.icns
src-tauri/icons/*.ico
!src-tauri/icons/source.png

# Signing keys — never commit these
*.key
*.key.pub
