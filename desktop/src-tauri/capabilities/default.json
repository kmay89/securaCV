{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Permissions for the SecuraCV Flasher main window: run the bundled espflash sidecar, open dialogs and external docs, and self-update.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "dialog:default",
    "updater:default",
    "process:default",
    "opener:default",
    {
      "identifier": "shell:allow-execute",
      "allow": [
        {
          "name": "binaries/espflash",
          "sidecar": true,
          "args": true
        }
      ]
    }
  ]
}
