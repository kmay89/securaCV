{
  "$schema": "../device.schema.json",
  "slug": "canary-wap",
  "name": "Canary WAP",
  "family": "canary-wap",
  "board": {
    "mcu": "ESP32-S3",
    "psram_mb": 8,
    "flash_mb": 8,
    "board_id": "xiao-esp32s3-sense",
    "envs": [
      "canary-wap-default",
      "canary-wap-usbdrive"
    ]
  },
  "peripherals": [
    "camera",
    "microphone",
    "sd_card",
    "gnss_uart",
    "tamper_input"
  ],
  "figure": "device.canary-wap",
  "cad": {
    "scad": "docs/hardware/enclosure/canary_wap_enclosure.scad",
    "enclosure_sets": [
      "wap-compact",
      "wap-battery",
      "wap-weather",
      "wap-clip-coupon",
      "thermal-outdoor-kit"
    ],
    "params": {
      "board_l": 21.0,
      "board_w": 17.5,
      "board_h": 1.2,
      "board_clear": 0.6,
      "stack_camera": 8.0,
      "stack_plain": 4.5
    }
  },
  "flasher": {
    "product": "securacv-canary-wap"
  }
}
