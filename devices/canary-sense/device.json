{
  "$schema": "../device.schema.json",
  "slug": "canary-sense",
  "name": "Canary Sense",
  "family": "canary-sense",
  "board": {
    "mcu": "ESP32-C6",
    "psram_mb": 0,
    "flash_mb": 4,
    "board_id": "xiao-esp32c6-mr60",
    "envs": [
      "canary-sense-default",
      "canary-sense-wellbeing"
    ]
  },
  "peripherals": [
    "ieee802154",
    "mmwave_radar",
    "ambient_light",
    "rgb_led"
  ],
  "figure": "device.canary-sense",
  "cad": {
    "scad": "docs/hardware/enclosure/canary_sense_enclosure.scad",
    "enclosure_sets": [
      "sense-radome",
      "sense-bedside-stand",
      "sense-in-wall-plate"
    ],
    "params": {
      "vm_l": {
        "brd": "mr60",
        "dim": "l"
      },
      "vm_w": {
        "brd": "mr60",
        "dim": "w"
      },
      "xiao_l": {
        "brd": "xiao",
        "dim": "l"
      },
      "xiao_w": {
        "brd": "xiao",
        "dim": "w"
      },
      "stack_sock_h": {
        "brd_fn": "brd_stack_sock_measured"
      },
      "xiao_below": 5.5,
      "vm_front_h": 3.5,
      "ant_h": 1.2,
      "pcb_t": 1.0,
      "board_clear": 0.6,
      "xiao_usb_z": 0.0
    }
  },
  "flasher": {
    "product": "securacv-canary-sense",
    "variants": [
      "securacv-canary-sense-wellbeing"
    ]
  },
  "site": {
    "model": "models/canary-sense.glb"
  }
}
