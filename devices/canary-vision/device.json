{
  "$schema": "../device.schema.json",
  "slug": "canary-vision",
  "name": "Canary Vision",
  "family": "canary-vision",
  "board": {
    "mcu": "ESP32-C3",
    "psram_mb": 0,
    "flash_mb": 4,
    "board_id": "xiao-esp32c3",
    "envs": [
      "canary-vision-xiao-c3"
    ]
  },
  "peripherals": [
    "vision_ai"
  ],
  "figure": "device.canary-vision",
  "cad": {
    "scad": "docs/hardware/enclosure/canary_vision_enclosure.scad",
    "enclosure_sets": [
      "vision-xiao-indoor",
      "vision-xiao-weather",
      "vision-mount-kit",
      "vision-doorbell"
    ],
    "params": {
      "vm_l": {
        "brd": "grove_v2",
        "dim": "l"
      },
      "vm_w": {
        "brd": "grove_v2",
        "dim": "w"
      },
      "xiao_l": {
        "brd": "xiao",
        "dim": "l"
      },
      "xiao_w": {
        "brd_fn": "brd_xiao_w_measured"
      },
      "stack_sock_h": {
        "brd_fn": "brd_stack_sock_measured"
      },
      "xiao_below": 5.5,
      "vm_front_h": 5.0,
      "cam_w": {
        "brd": "ov5647",
        "dim": "w"
      },
      "cam_h": {
        "brd": "ov5647",
        "dim": "l"
      },
      "pcb_t": {
        "brd": "grove_v2",
        "dim": "t"
      },
      "board_clear": 0.6
    }
  },
  "flasher": {
    "product": "securacv-canary-vision-xiao-c3"
  },
  "site": {
    "model": "models/canary-vision.glb"
  }
}
