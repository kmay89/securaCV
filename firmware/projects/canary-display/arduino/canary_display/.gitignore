# Per-user staged files — written by `./setup.sh arduino <watch|dash>`,
# never committed (flavor_local.h is a per-checkout choice; secrets.h
# carries credentials). Everything else in this directory — including the
# flavor-dispatching pins.h/flavor_config.h/flavor_select.h and both
# flavors' committed pin/config copies — is generated by setup.sh and
# sync-guarded, so a raw GitHub zip compiles with no setup step.
flavor_local.h
secrets.h
