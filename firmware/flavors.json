[
  {
    "name": "canary",
    "dir": "firmware/canary",
    "build_envs": ["dev", "release", "full"],
    "check_env": "release",
    "pip_extras": "intelhex",
    "isolated_core_envs": ["full"],
    "size_guard": {
      "bin": ".pio/build/release/firmware.bin",
      "slot_bytes": 1966080,
      "slot_name": "0x1E0000 OTA slot (partitions_ota.csv ota_0/ota_1)"
    }
  },
  {
    "name": "canary-wap",
    "dir": "firmware/projects/canary-wap",
    "build_envs": ["canary-wap-default"],
    "check_env": "canary-wap-default"
  },
  {
    "name": "canary-vision",
    "dir": "firmware/projects/canary-vision",
    "build_envs": ["canary-vision-default", "canary-vision-xiao-c3", "canary-vision-xiao-s3"],
    "check_env": "canary-vision-default",
    "pre_step": "secrets_header",
    "size_guard": {
      "bin": ".pio/build/canary-vision-default/firmware.bin",
      "slot_bytes": 1310720,
      "slot_name": "0x140000 OTA slot (ESP32-C3 default.csv app0/app1)"
    }
  },
  {
    "name": "canary-sense",
    "dir": "firmware/projects/canary-sense",
    "build_envs": ["canary-sense-default", "canary-sense-wellbeing"],
    "check_env": "canary-sense-default",
    "pre_step": "secrets_header",
    "size_guard": {
      "bin": ".pio/build/canary-sense-default/firmware.bin",
      "slot_bytes": 1310720,
      "slot_name": "0x140000 OTA slot (ESP32-C6 default.csv app0/app1)"
    }
  }
]
