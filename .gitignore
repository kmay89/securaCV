# Rust build artifacts (root and nested crates, e.g. desktop/hub-io/target/)
/target/
**/target/
**/*.rs.bk

# IDE
.idea/
.vscode/
*.swp
*.swo
*~

# Python
__pycache__/
*.pyc

# OS
.DS_Store
**/.DS_Store
Thumbs.db

# Local development
*.db
*.db-journal
/vault/
demo_out/
demo_witness.db

# Node — CI installs playwright fresh for the canary-local boot probe;
# a vendored node_modules shadows the runner's browser-matched install
node_modules/

# Secrets (never commit these)
*.pem
*.key
api_token
.env
.env.local
secrets.h
.device_key_seed
# =============================== 
# Firmware secrets (DO NOT COMMIT)
# ===============================

# Common secret headers
secrets.h
secret.h

# PlatformIO / Arduino secret variants
**/secrets.h
**/secret.h
**/secrets/*.h
# But allow example templates
!**/secrets/*.example.h

# PlatformIO local config
platformio_override.ini

# Environment / credential files
.env
.env.*
# But allow committed templates
!.env.example

firmware/projects/canary-wap/tests_host/test_chirp_protocol_invariants
firmware/projects/canary-wap/tests_host/test_mesh_coexistence
firmware/projects/canary-wap/tests_host/test_evidence_drive_logic
firmware/projects/canary-wap/tests_host/test_evidence_update_verify
firmware/projects/canary-companion/tests_host/test_companion_cores

# Fetched detection models (scripts/fetch_detection_model.sh) — not committed
vendor/models/*.onnx
docs/hardware/enclosure/dev_*.stl
# gen_3mf.py outputs: build artifacts, regenerate with `python3 gen_3mf.py <set>`
docs/hardware/enclosure/lcd7_*.3mf
docs/hardware/enclosure/stick_*.3mf
docs/hardware/enclosure/c3_*.3mf
docs/hardware/enclosure/_3mf_*.stl

# Local scratch
/.tmp/

# Vendor board CAD is gzipped in-repo (boards/vendor/*.step.gz); ignore raw
# uncompressed drops and gen_boards.py scratch files.
boards/vendor/*.step
canary-local/boards/*.tmp.glb
canary-local/boards/*.src.step

# Generated Xcode projects. Both Apple targets generate their project from a
# committed XcodeGen spec on every build (ios/project.yml,
# tvos/WitnessWall/project.yml) precisely so it can't rot — a committed
# .pbxproj would be the thing that drifts.
*.xcodeproj/
*.xcworkspace/

# Apple build output: staged Rust core slices, archives, exported .ipa.
tvos/build/
.mypy_cache/
