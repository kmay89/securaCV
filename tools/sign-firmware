#!/usr/bin/env python3
"""sign-firmware — sign one firmware image and emit its manifest, safely.

The one-stop wrapper around firmware/scripts/ota_release.py that the program
brief asked for. It does three things the raw signer leaves to the operator:

  1. REFUSES a private key that lives inside the repository checkout (or
     under a path that looks like one), so a release key can never be
     committed by accident. The key belongs in a secret store or an offline
     ceremony machine (docs/OTA.md "The key"); the CI workflow reads it from
     the OTA_SIGNING_KEY_PEM secret.
  2. Builds the signed manifest (image signature, manifest signature, the
     BLE header signature where the product fits) with the board and chip
     the image was built for (manifest_version 2) when you name them.
  3. VERIFIES what it just wrote against the public key before it returns —
     a manifest this tool emits has been checked the way a device will check
     it.

Usage:
  tools/sign-firmware keygen  --key /secure/releaser.pem
  tools/sign-firmware manifest --key /secure/releaser.pem \
      --product securacv-canary-sense --version 2.5.0 \
      --url https://github.com/kmay89/securaCV/releases/download/v2.5.0/canary-sense.bin \
      --board xiao-esp32c6-mr60 --chip esp32c6 [--min-version 2.4.0] \
      --out manifest-canary-sense.json firmware.bin
  tools/sign-firmware verify --pubkey firmware/common/ota/src/ota_release_key.h \
      --manifest manifest-canary-sense.json firmware.bin

Everything else (index, pubkey-header, ble-header) is ota_release.py's and
is passed through unchanged: `tools/sign-firmware <command> ...`.
"""

from __future__ import annotations

import os
import subprocess
import sys
from pathlib import Path

REPO = Path(__file__).resolve().parents[1]
SIGNER = REPO / "firmware" / "scripts" / "ota_release.py"


def _looks_like_a_checkout(path: Path) -> bool:
    """Is `path` inside any git checkout? (.git in an ancestor)."""
    for parent in [path] + list(path.parents):
        if (parent / ".git").exists():
            return True
    return False


def _refuse_key_in_repo(key: str) -> None:
    key_path = Path(key).expanduser().resolve()
    if key_path == REPO or REPO in key_path.parents or _looks_like_a_checkout(key_path.parent):
        sys.exit(
            f"refusing: the private key {key_path} is inside a source checkout.\n"
            "A release key never lives in the repository — keep it in a secret "
            "store or on the offline ceremony machine (docs/OTA.md, 'The key')."
        )


def _run(args: list[str]) -> int:
    return subprocess.call([sys.executable, str(SIGNER), *args])


def main(argv: list[str]) -> int:
    if not argv or argv[0] in ("-h", "--help"):
        print(__doc__)
        return 0
    cmd, rest = argv[0], argv[1:]
    # `--key` is this tool's spelling; the signer says `--private-key`.
    rest = ["--private-key" if a == "--key" else a for a in rest]

    if cmd == "keygen":
        if "--private-key" in rest:
            _refuse_key_in_repo(rest[rest.index("--private-key") + 1])
        return _run(["keygen", *rest])

    if cmd == "manifest":
        if "--private-key" not in rest:
            sys.exit("manifest: --key <releaser.pem> is required")
        key = rest[rest.index("--private-key") + 1]
        _refuse_key_in_repo(key)
        if "--out" not in rest:
            sys.exit("manifest: --out <manifest.json> is required (the result is verified from disk)")
        out = rest[rest.index("--out") + 1]
        firmware = rest[-1]
        rc = _run(["manifest", *rest])
        if rc != 0:
            return rc
        # Verify what was written, the way a device will: against the PUBLIC
        # key derived from the private one (so a wrong key file fails here).
        pub = _public_pem_from_private(key)
        if pub is None:
            print("note: could not derive the public key; run `verify` with the release pubkey header.")
            return 0
        rc = subprocess.call([sys.executable, str(SIGNER), "verify", "--pubkey", pub,
                              "--manifest", out, firmware])
        if rc == 0:
            print(f"verified: {out} checks out against the release key")
        return rc

    # verify / index / pubkey-header / ble-header: pass through.
    return _run([cmd, *rest])


def _public_pem_from_private(key_path: str) -> str | None:
    try:
        from cryptography.hazmat.primitives import serialization
        pem = Path(key_path).expanduser().read_bytes()
        priv = serialization.load_pem_private_key(pem, password=None)
        pub = priv.public_key().public_bytes(
            serialization.Encoding.PEM, serialization.PublicFormat.SubjectPublicKeyInfo)
        tmp = Path(os.environ.get("TMPDIR", "/tmp")) / f"securacv-release-pub-{os.getpid()}.pem"
        tmp.write_bytes(pub)
        return str(tmp)
    except Exception:  # noqa: BLE001 — a missing lib or a bad PEM both mean "cannot verify here"
        return None


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
