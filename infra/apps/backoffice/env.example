# The backoffice's .env on the server (/srv/apps/backoffice/.env, mode 0640, owner ops, group kit).
# The full list with explanations is backoffice/.env.example in the repository;
# these are the ones a real deployment cannot go without. Keep the same values
# in your password manager: they are what a new server needs after this one dies.
BACKOFFICE_BASE_URL=https://ops.securacv.com
SITE_ORIGIN=https://securacv.com
COMPANY_NAME=Errer Labs
PRODUCT_NAME=SecuraCV
SUPPORT_ADDR=hello@securacv.com
MAIL_FROM=Errer Labs <hello@securacv.com>
OPERATOR_EMAIL=
OPERATOR_TZ=America/New_York
SHIP_FROM_STATE=MA

# Stripe — test-mode values for the shadow fortnight, live ones after (GO_LIVE.md)
STRIPE_WEBHOOK_SECRET=
STRIPE_API_KEY=

# Mail in and out
SMTP_URL=
IMAP_URL=

# Backups: off-site, encrypted, proven weekly. Backblaze B2 or Cloudflare R2 are free at this size.
BACKUP_S3_URL=
BACKUP_S3_KEY=
BACKUP_S3_SECRET=
BACKUP_S3_REGION=auto
BACKUP_ENCRYPTION_KEY=

# Optional: the carrier's word instead of the estimate
USPS_CLIENT_ID=
USPS_CLIENT_SECRET=
