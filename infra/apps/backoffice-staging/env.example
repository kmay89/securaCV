# Staging's .env (/srv/apps/backoffice-staging/.env, mode 0640, owner ops, group kit).
# The same keys as the backoffice's, with these differences — the app enforces the first three itself:
#   - STRIPE_API_KEY must be a TEST key (a live one is refused at boot); the webhook secret is the one from a
#     test-mode endpoint pointed at https://<staging host>/webhooks/stripe, so test checkouts land here;
#   - SMTP_URL / IMAP_URL are muted unless STAGING_ALLOW_MAIL=1 and SMTP_URL is a throwaway relay;
#   - the backup bucket values are production's, READ ONLY in effect: `kit refresh` restores the latest
#     production copy from it, and the app never uploads a staging backup (a B2 application key limited
#     to read is the right key to put here).
BACKOFFICE_BASE_URL=https://staging.securacv.com
SITE_ORIGIN=https://securacv.com
COMPANY_NAME=Errer Labs
PRODUCT_NAME=SecuraCV
SUPPORT_ADDR=hello@securacv.com
MAIL_FROM=Errer Labs (staging) <hello@securacv.com>
OPERATOR_EMAIL=
OPERATOR_TZ=America/New_York
SHIP_FROM_STATE=MA

# Stripe, TEST mode only
STRIPE_WEBHOOK_SECRET=
STRIPE_API_KEY=

# Mail: muted unless STAGING_ALLOW_MAIL=1 (then point SMTP_URL at a throwaway relay)
STAGING_ALLOW_MAIL=
SMTP_URL=
IMAP_URL=

# Production's bucket, for the nightly refresh (read is enough; the app never writes here from staging)
BACKUP_S3_URL=
BACKUP_S3_KEY=
BACKUP_S3_SECRET=
BACKUP_S3_REGION=auto
BACKUP_ENCRYPTION_KEY=

# Feature flags to try before production has them: FLAG_<NAME>=1 pins one on (backoffice/src/flags.mjs)
# FLAG_STRIPE_TAX=1
