# backoffice — every knob. Copy to .env (never committed; .gitignore covers it)
# and `set -a; . ./.env; set +a` or hand it to docker compose. Blank = feature off.

# Where the one SQLite file and the backups live (a Docker volume, or a dir you rsync).
BACKOFFICE_DATA_DIR=./data
# BACKOFFICE_DB=./data/backoffice.db

# Bind. Keep 127.0.0.1 and put Caddy/nginx in front for TLS (deploy/Caddyfile).
BACKOFFICE_HOST=127.0.0.1
BACKOFFICE_PORT=8787
# The public URL the reverse proxy serves — used in every link we mail out.
BACKOFFICE_BASE_URL=https://ops.securacv.com

# The website: CORS origin for /forms, and the home of store.json (the catalog).
SITE_ORIGIN=https://securacv.com
STORE_JSON=https://securacv.com/store.json
# The box catalog and each SKU's packed parcel (the website's shipping.json); blank = the file beside store.json
SHIPPING_JSON=

COMPANY_NAME=Errer Labs
PRODUCT_NAME=SecuraCV
# The mailbox the helpdesk reads (IMAP) and replies from (SMTP). One address.
SUPPORT_ADDR=hello@securacv.com
MAIL_FROM="Errer Labs <hello@securacv.com>"
# Any SMTP relay: your mailbox provider's submission port, a self-hosted Postfix,
# or a $0-tier relay. smtp:// = STARTTLS on 587; smtps:// = implicit TLS on 465.
SMTP_URL=smtp://hello%40securacv.com:app-password@smtp.example.com:587
# Implicit-TLS IMAP (993). The path is the folder; INBOX if omitted.
IMAP_URL=imaps://hello%40securacv.com:app-password@imap.example.com:993/INBOX

# Stripe → Developers → Webhooks → add endpoint ${BACKOFFICE_BASE_URL}/webhooks/stripe
# events: checkout.session.completed, charge.refunded, payout.paid,
#         customer.subscription.created/updated/deleted, invoice.paid
STRIPE_WEBHOOK_SECRET=whsec_...

# Exceptions open deduplicated issues here (doc 20). A fine-grained PAT with
# "Issues: read and write" on this one repo is enough. Blank = exceptions stay in the admin.
GITHUB_TOKEN=
GITHUB_REPO=kmay89/securaCV

SUPPORT_SLA_HOURS=24
SESSION_HOURS=12
BACKUP_KEEP=14

# ---- reliability (Health page / `backoffice doctor` check each of these)
# Off-site copy of every checked backup: any S3-compatible bucket (Backblaze B2, Cloudflare R2, Tigris, AWS S3).
# URL = https://<endpoint>/<bucket>/<prefix>; a weekly drill pulls the latest copy back and proves it boots.
BACKUP_S3_URL=
BACKUP_S3_KEY=
BACKUP_S3_SECRET=
BACKUP_S3_REGION=us-east-1
# A long passphrase: the copy is sealed (AES-256-GCM) before it leaves the machine. Keep it somewhere the server is not.
BACKUP_ENCRYPTION_KEY=
# The morning digest (today's list, the thirty-day numbers, the health checklist) goes here at DIGEST_HOUR UTC.
OPERATOR_EMAIL=
DIGEST_HOUR=7
# Reconciliation and line-item fetches need a restricted Stripe key: read charges, payouts, checkout sessions.
STRIPE_API_KEY=

# ---- the loop
# The operator's timezone: every time in the admin, the digest hour and a campaign's scheduled time are read in it. IANA name.
OPERATOR_TZ=America/New_York
# Where parcels ship from (two-letter state): the delivery estimate in every tracking mail counts bands from here.
SHIP_FROM_STATE=MA
# USPS Developer Portal → an app with the Tracking API → its client id and secret. With them the hourly job asks
# the carrier about every open parcel, marks delivered on the carrier's day and raises a carrier alert as an exception.
# Blank = customers see the estimate and the Decide queue asks you after a week.
USPS_CLIENT_ID=
USPS_CLIENT_SECRET=
# USPS_API_BASE=https://apis.usps.com
