# Copy to `.env` and fill in — points this detector at your securaCV hub.
#
# The hub is the Pi running HAOS + the Mosquitto add-on. Use its hostname
# (homeassistant.local) or its LAN IP.
FRIGATE_MQTT_HOST=homeassistant.local

# A Mosquitto login the hub accepts. Easiest: in Home Assistant create a user
# (Settings → People) named e.g. `frigate`; the Mosquitto add-on authenticates
# HA users. Then put that user + password here.
FRIGATE_MQTT_USER=frigate
FRIGATE_MQTT_PASSWORD=change-me
