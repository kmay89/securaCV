<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- APNs for away-from-home alerts (metadata-only wake, per docs §5). -->
  <key>aps-environment</key>
  <string>development</string>

  <!-- Critical Alerts: the smoke-alarm bypass. Gated by Apple; the app falls
       back to time-sensitive automatically until this entitlement is granted. -->
  <key>com.apple.developer.usernotifications.critical-alerts</key>
  <true/>

  <!-- Time Sensitive: the ordinary capability (no Apple grant) that lets
       .timeSensitive actually break through Focus — it is BOTH the everyday
       alert level and the critical-alert fallback, so without it the push
       discipline's middle rung silently degrades to a plain banner. -->
  <key>com.apple.developer.usernotifications.time-sensitive</key>
  <true/>

  <!-- HomeKit -->
  <key>com.apple.developer.homekit</key>
  <true/>

  <!-- CloudKit private database — the user's own iCloud is the sync backend;
       SecuraCV runs no server and cannot read it. -->
  <key>com.apple.developer.icloud-services</key>
  <array>
    <string>CloudKit</string>
  </array>
  <key>com.apple.developer.icloud-container-identifiers</key>
  <array>
    <string>iCloud.com.securacv.witness</string>
  </array>

  <!-- Shared container so the widgets can read cached fleet state. (The NSE
       does not join it yet: its target carries no entitlements file at all —
       when wake hydration lands, give the NSE its own entitlements with this
       group, or it cannot open the container.) -->
  <key>com.apple.security.application-groups</key>
  <array>
    <string>group.com.securacv.witness</string>
  </array>
</dict>
</plist>
