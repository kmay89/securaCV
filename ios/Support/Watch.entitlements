<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- The watch-LOCAL app group: the watch app writes the WristSnapshot
       cache here and the watch widgets read it. Deliberately NOT the phone's
       group.com.securacv.witness — app groups never sync between iPhone and
       Watch (RFC §3.2), so sharing that name would only imply a data path
       that cannot exist. No aps-environment either: the watch registers no
       independent push token (RFC §3.4). One entitlements file for Debug and
       Release — nothing here needs an Apple grant, so there is no dev/full
       split like the phone app's. -->
  <key>com.apple.security.application-groups</key>
  <array>
    <string>group.com.securacv.witness.watch</string>
  </array>
</dict>
</plist>
