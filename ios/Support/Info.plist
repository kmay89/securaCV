<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>CFBundleName</key>
  <string>SecuraCV</string>
  <key>CFBundleDisplayName</key>
  <string>SecuraCV</string>
  <key>CFBundleShortVersionString</key>
  <string>$(MARKETING_VERSION)</string>
  <key>CFBundleVersion</key>
  <string>$(CURRENT_PROJECT_VERSION)</string>

  <!-- Build stamp baked by scripts/stamp_build.sh (the "never a guess" panel). -->
  <key>SECURACV_BUILD_REV</key>
  <string>$(SECURACV_BUILD_REV)</string>
  <key>SECURACV_FW_TRAIN</key>
  <string>$(SECURACV_FW_TRAIN)</string>

  <!-- Export compliance: only Apple's OS crypto (CryptoKit / Secure Enclave /
       TLS) with standard algorithms — the exempt category. Declaring it here
       keeps TestFlight from parking every build on a manual questionnaire. -->
  <key>ITSAppUsesNonExemptEncryption</key>
  <false/>

  <!-- Deep links: the securacv:// dialect widgets and links speak
       (Shared/AppRoute.swift is the one parser — change both together).
       Routing can only switch tabs and scroll lists the user already owns;
       there is nothing a link can open, export, or silence. -->
  <key>CFBundleURLTypes</key>
  <array>
    <dict>
      <key>CFBundleURLName</key>
      <string>com.securacv.app</string>
      <key>CFBundleURLSchemes</key>
      <array>
        <string>securacv</string>
      </array>
    </dict>
  </array>

  <!-- Live Activities / Dynamic Island -->
  <key>NSSupportsLiveActivities</key>
  <true/>
  <key>NSSupportsLiveActivitiesFrequentUpdates</key>
  <true/>

  <!-- App Transport Security: every Canary is reached over plain HTTP at a
       .local name or a private IP (the pairing receipt hands the phone
       http://<canary>.local), and since iOS 10 ATS refuses cleartext to .local
       and unqualified hosts unless local networking is allowed explicitly.
       Without this key every device call failed with -1022 on the phone while
       the tvOS Wall (which has always carried it) worked. Scoped to LOCAL
       networking only: arbitrary public http:// loads stay blocked, so the
       "nothing off-network" promise below is still enforced by the OS. -->
  <key>NSAppTransportSecurity</key>
  <dict>
    <key>NSAllowsLocalNetworking</key>
    <true/>
  </dict>

  <!-- Local network + Bonjour: reach Canaries on the LAN, nothing off-network. -->
  <key>NSLocalNetworkUsageDescription</key>
  <string>SecuraCV finds and talks to your Canaries on your own Wi-Fi. Nothing is sent to any company server.</string>
  <key>NSBonjourServices</key>
  <array>
    <string>_securacv._tcp</string>
  </array>

  <!-- Bluetooth: hear a Canary directly even when Wi-Fi is down. -->
  <key>NSBluetoothAlwaysUsageDescription</key>
  <string>SecuraCV connects to your Canaries over Bluetooth so you still get status if the network drops.</string>

  <!-- HomeKit: publish coarse witness state (motion/occupancy/tamper), never video. -->
  <key>NSHomeKitUsageDescription</key>
  <string>Add your Canaries to Apple Home so they can trigger your automations. Only coarse status is shared — never footage.</string>

  <!-- No microphone usage string, on purpose: the app records nothing and
       has no talk feature. If two-way talk ever lands, the mic string, the
       session plumbing, and the UI arrive together in that change. -->

  <!-- CloudKit sharing: without this key iOS opens an invitation link in
       Safari instead of handing it to the app, so "someone else can be told
       if nobody answers" would end at a web page. It only declares that the
       app can ACCEPT a share; what a share may contain is decided in
       HouseholdRelay (one zone, escalations only). -->
  <key>CKSharingSupported</key>
  <true/>

  <!-- Background delivery for the away-path wakes (APNs). ONLY
       remote-notification: the BLE scan is foreground-only by design
       (BLEConsole/FleetStore stop it when the scene deactivates), and no
       code plays background audio — declaring modes nothing uses is an App
       Review rejection trigger and an overclaim besides. -->
  <key>UIBackgroundModes</key>
  <array>
    <string>remote-notification</string>
  </array>

  <key>UILaunchScreen</key>
  <dict/>
  <key>UIApplicationSceneManifest</key>
  <dict>
    <key>UIApplicationSupportsMultipleScenes</key>
    <true/>
  </dict>
  <key>UISupportedInterfaceOrientations</key>
  <array>
    <string>UIInterfaceOrientationPortrait</string>
    <string>UIInterfaceOrientationLandscapeLeft</string>
    <string>UIInterfaceOrientationLandscapeRight</string>
  </array>
  <key>UISupportedInterfaceOrientations~ipad</key>
  <array>
    <string>UIInterfaceOrientationPortrait</string>
    <string>UIInterfaceOrientationPortraitUpsideDown</string>
    <string>UIInterfaceOrientationLandscapeLeft</string>
    <string>UIInterfaceOrientationLandscapeRight</string>
  </array>
</dict>
</plist>
