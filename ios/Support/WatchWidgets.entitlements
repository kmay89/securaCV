<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- Reads the WristSnapshot cache the watch app writes. See
       Watch.entitlements for why this group is watch-local. -->
  <key>com.apple.security.application-groups</key>
  <array>
    <string>group.com.securacv.witness.watch</string>
  </array>
</dict>
</plist>
