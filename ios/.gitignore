# The Xcode project is GENERATED from project.yml (xcodegen) on every build and
# every night — never committed, so it can't rot or drift. This mirrors the
# desktop apps, whose Tauri Xcode project is likewise generated from config.
*.xcodeproj
*.xcworkspace

# Local overrides (signing team etc.) — seeded by scripts/heal.sh from
# $APPLE_DEVELOPMENT_TEAM and merged at generate time via .local-spec.yml.
local.yml
.local-spec.yml

# Build output
build/
# The second, CloudKit-enabled type-check pass in scripts/heal.sh keeps its own
# derived data so it cannot disturb the products build/ holds for the
# watch-app embed proof.
build-cloudkit/
DerivedData/
*.ipa
*.dSYM.zip

# SwiftPM
.build/
.swiftpm/

# Apple signing material must NEVER land in git.
*.p8
*.p12
*.mobileprovision
*.cer
