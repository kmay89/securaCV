{
  "permissions": {
    "deny": [
      "Read(./canary-local/emulator/dist/**)",
      "Read(./boards/vendor/**)",
      "Read(./**/*.glb)",
      "Read(./**/*.stl)",
      "Read(./**/*.3mf)",
      "Read(./**/*.step.gz)",
      "Read(./**/*.icns)",
      "Read(./firmware/projects/canary-wap/arduino/canary_wap/web_assets_gz.h)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Read",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/scripts/hooks/read_guard.py\""
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/scripts/hooks/session_brief.py\""
          }
        ]
      }
    ]
  }
}
